# Greenspector v2 — redirections 301 (migration WordPress → site statique + blog)
# Régénérer : npm run generate-redirects
# Sources : post-sitemap.xml, marketing.htaccess, page-redirects.json, link-audit-report.json

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# --- Canonical host : HTTPS + sans www (greenspector.com) ---
RewriteCond %{HTTP_HOST} ^www\.greenspector\.com$ [NC]
RewriteRule ^ https://greenspector.com%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP_HOST} ^greenspector\.com$ [NC]
RewriteCond %{HTTPS} off
RewriteRule ^ https://greenspector.com%{REQUEST_URI} [R=301,L]

# --- Blog infrastructure → blog.greenspector.com ---
RewriteRule ^blog-fr/?(.*)$ https://blog.greenspector.com/$1 [R=301,L,NC]
RewriteRule ^en/blog-en/?(.*)$ https://blog.greenspector.com/en/$1 [R=301,L,NC]
RewriteRule ^wp-content/(.*)$ https://blog.greenspector.com/wp-content/$1 [R=301,L,NC]
RewriteRule ^wp-admin(.*)$ https://blog.greenspector.com/wp-admin$1 [R=301,L,NC]
RewriteRule ^wp-json/(.*)$ https://blog.greenspector.com/wp-json/$1 [R=301,L,NC]
RewriteRule ^feed/?$ https://blog.greenspector.com/feed/ [R=301,L,NC]
RewriteRule ^comments/feed/?$ https://blog.greenspector.com/comments/feed/ [R=301,L,NC]
RewriteRule ^blog/(.*)$ https://blog.greenspector.com/blog/$1 [R=301,L,NC]
RewriteRule ^author/(.*)$ https://blog.greenspector.com/author/$1 [R=301,L,NC]
RewriteRule ^20[0-9]{2}/(.*)$ https://blog.greenspector.com/20$1 [R=301,L,NC]

# --- Ancien préfixe /fr/ (site multilingue legacy) ---
RewriteRule ^fr/contact/?$ /contact/ [R=301,L,NC]
RewriteRule ^fr/accueil/?$ / [R=301,L,NC]
RewriteRule ^fr/?$ / [R=301,L,NC]

# Anciens permaliens /fr/articles/YYYY-MM-DD-slug → /slug (puis règle article → blog)
RewriteRule ^fr/articles/[0-9]{4}-[0-9]{2}-[0-9]{2}-(.+)/?$ /$1/ [R=301,L,NC]
RewriteRule ^articles/[0-9]{4}-[0-9]{2}-[0-9]{2}-(.+)/?$ /$1/ [R=301,L,NC]

# Anciens chemins /fr/news/ → blog (slug WP souvent différent)
RewriteRule ^fr/news/(.*)$ https://blog.greenspector.com/fr/news/$1 [R=301,L,NC]
RewriteRule ^news/(.*)$ https://blog.greenspector.com/news/$1 [R=301,L,NC]

# Reste du préfixe /fr/ → sans préfixe (réutilise règles racine)
RewriteRule ^fr/(.*)$ /$1 [R=301,L,NC]

# Fichiers téléchargements legacy
RewriteRule ^downloads/(.*)$ https://blog.greenspector.com/wp-content/uploads/$1 [R=301,L,NC]

RewriteRule ^en/articles/[0-9]{4}-[0-9]{2}-[0-9]{2}-(.+)/?$ /en/$1/ [R=301,L,NC]
RewriteRule ^en/articles/(.*)$ https://blog.greenspector.com/en/$1 [R=301,L,NC]

# --- Greenspector Studio (FR) ---
RewriteRule ^mesure-performance-et-energie-du-numerique/?$ /studio/banc-tests-mobiles/ [R=301,L,NC]
RewriteRule ^impact-environnemental-numerique/?$ /studio/mesure-impact-environnemental-numerique/ [R=301,L,NC]
RewriteRule ^pilotez-ecoconception-par-les-resultats/?$ /studio/outil-ecoconception-logicielle/ [R=301,L,NC]
RewriteRule ^diagnostic-batterie-performance-2/?$ /studio/mesure-decharge-batterie/ [R=301,L,NC]
RewriteRule ^diagnostic-batterie-performance/?$ /studio/mesure-decharge-batterie/ [R=301,L,NC]
RewriteRule ^devgreenops-3/?$ /studio/devgreenops/ [R=301,L,NC]
RewriteRule ^devgreenops/?$ /studio/devgreenops/ [R=301,L,NC]
RewriteRule ^green-testing-qa/?$ /studio/mesure-performance-app/ [R=301,L,NC]
RewriteRule ^gs-pour-la-performance-applicative/?$ /studio/mesure-performance-app/ [R=301,L,NC]

# --- Conseil (FR) ---
RewriteRule ^services-conseils-2/?$ /conseil/ecoconception-logicielle/ [R=301,L,NC]
RewriteRule ^audit-application-mobile/?$ /conseil/audit-application-mobile/ [R=301,L,NC]

# --- Tarifs, contact, connexion (FR) ---
RewriteRule ^tarifs/?$ /tarifs-greenspector-studio/ [R=301,L,NC]
RewriteRule ^contactez-nous/?$ /contact/ [R=301,L,NC]
RewriteRule ^login/?$ /connexion/ [R=301,L,NC]

# --- À propos (FR) ---
RewriteRule ^l-entreprise/?$ /a-propos/equipe-greenspector/ [R=301,L,NC]
RewriteRule ^a-propos-equipe-greenspector/?$ /a-propos/equipe-greenspector/ [R=301,L,NC]
