# --- Greenspector Studio (EN) ---
RewriteRule ^en/home/?$ /en/ [R=301,L,NC]
RewriteRule ^en/overview/?$ /en/studio/mobile-device-testing/ [R=301,L,NC]
RewriteRule ^en/environmental-impacts/?$ /en/studio/environmental-impact-measurement/ [R=301,L,NC]
