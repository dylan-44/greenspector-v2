# =====================================================================
#  greenspector.com - redirections depuis l'ancien site WordPress
#
#  Base : htaccess.txt (generate-htaccess.sh / mapping_pages.csv)
#  + canonical sans www (HTTPS gere par l'hebergeur), corrections, complements v2
#
#  Prerequis hebergeur :
#    - mod_rewrite (canonical host) + mod_alias (RedirectMatch)
#    - AllowOverride incluant FileInfo et RewriteOptions
#
#  Test :
#      curl -sI https://greenspector.com/audit-application-mobile/
#      attendu : 301 vers /conseil/audit-application-mobile/
#
#  L'ordre des directives est significatif : la premiere qui correspond
#  l'emporte. Ne pas trier le fichier.
# =====================================================================

# ---------------------------------------------------------------------
# 0) Canonical host : www -> apex (HTTPS force par l'infra hebergeur)
#    Test : curl -sI https://www.greenspector.com/
#    attendu : 301 vers https://greenspector.com/
# ---------------------------------------------------------------------
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.greenspector\.com$ [NC]
RewriteRule ^ https://greenspector.com%{REQUEST_URI} [R=301,L]
RewriteCond %{QUERY_STRING} ^p=5265$ [NC]
RewriteRule ^$ https://greenspector.com/? [R=301,L]

# ---------------------------------------------------------------------
# 1) Anciens points d'entree WordPress (wp-login, xmlrpc, wp-cron)
#    tombent dans la regle anti-scan ci-dessous : 404, pas de redirection.
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# 2) Bruit de scan -> 404 sec, jamais de redirection.
#    ~71 000 requetes en 14 jours avant migration.
# ---------------------------------------------------------------------
RedirectMatch 404 (?i)\.(php|env|git|sql|bak|ini|yml|asp|aspx|jsp|cgi)$
RedirectMatch 404 (?i)^/(\.git|\.env|\.aws|\.npmrc|vendor|cgi-bin)(/|$)
RedirectMatch 404 (?i)^/(graphql|dns-query|resolve|admin|query)/?$

# ---------------------------------------------------------------------
# 3) Infrastructure WordPress (wp-content, wp-admin, wp-json, sitemaps,
#    /downloads/) : pas de redirection. Ces URLs repondent en 404.
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# 4) Familles mecaniques -> blog
#    Enumerer ces URLs une par une n'apporterait aucune lisibilite :
#    elles se deduisent entierement de leur forme.
# ---------------------------------------------------------------------
# taxonomies : /blog/<categorie|tag>/  et /en/blog/...
RedirectMatch 301 ^/(?:fr/)?(blog/.*)$        /ressources/blog/
RedirectMatch 301 ^/(en/blog/.*)$             /en/resources/blog/
# auteurs
RedirectMatch 301 ^/(?:fr/)?(author/.*)$      /ressources/blog/
RedirectMatch 301 ^/(en/author/.*)$           /en/resources/blog/
# archives de dates : /2025/06/05/ et /en/2025/06/
RedirectMatch 301 ^/(?:fr/)?([0-9]{4}/[0-9]{2}(?:/[0-9]{2})?/?)$      /ressources/blog/
RedirectMatch 301 ^/(en/[0-9]{4}/[0-9]{2}(?:/[0-9]{2})?/?)$           /en/resources/blog/
# pagination
RedirectMatch 301 ^/(?:fr/)?(page/[0-9]+/?)$                          /ressources/blog/
RedirectMatch 301 ^/(en/page/[0-9]+/?)$                               /en/resources/blog/
RedirectMatch 301 ^/((?:blog-fr|en/blog-en)/[0-9]+/?)$                /ressources/blog/
RedirectMatch 301 ^/(?:fr/)?blog-fr/(.*)$                             /ressources/blog/
RedirectMatch 301 ^/en/blog-en/(.*)$                                  /en/resources/blog/
# suffixes WordPress sur n'importe quel chemin
RedirectMatch 301 ^/en/(.*(?:feed|embed|amp|trackback)(?:/(?:atom|rdf|rss|rss2))?/?)$ /en/resources/blog/
RedirectMatch 301 ^/(?:fr/)?(.*(?:feed|embed|amp|trackback)(?:/(?:atom|rdf|rss|rss2))?/?)$ /ressources/blog/

# ---------------------------------------------------------------------
# 5) Anciens sous-arbres supprimes -> index equivalent du nouveau site
#    Etudes de cas nommees AVANT la regle generique etude-de-cas/*
# ---------------------------------------------------------------------
RedirectMatch 301 ^/(?:fr/)?etude-de-cas/comment-bouygues-telecom-obtient-le-certificat-de-sobriete-numerique-niveau-argent-et-economise-693-tonnes-de-co2eq-par-an-sur-son-application-mobile/?$ https://greenspector.com/ressources/etudes-de-cas/bouygues-telecom-sobriete-numerique-mobile/
RedirectMatch 301 ^/(?:fr/)?etude-de-cas/bruxelles-environnement-ecobuild/?$ https://greenspector.com/ressources/etudes-de-cas/bruxelles-environnement-ecobuild/
RedirectMatch 301 ^/(?:fr/)?etude-de-cas/elementor-23306/?$ https://greenspector.com/ressources/etudes-de-cas/treebal-application-ecoresponsable/
RedirectMatch 301 ^/(?:fr/)?etude-de-cas/credit-agricole/?$ https://greenspector.com/ressources/etudes-de-cas/cats-smartuse-application-bancaire/
RedirectMatch 301 ^/en/(?:etude-de-cas|certifications)(/|$)                   https://greenspector.com/en/resources/case-studies/
RedirectMatch 301 ^/(?:fr/)?(?:ressources/)?(?:etude-de-cas|certifications)(/|$) https://greenspector.com/ressources/etudes-de-cas/
RedirectMatch 301 ^/(?:fr/)?webinaires(/|$)                                   /ressources/blog/

