  "bodyHtml": "<section class=\"hero hero-home hero-home-split\" aria-labelledby=\"hero-title\">\n            <div class=\"container\">\n                <div class=\"row align-items-center g-4 g-lg-5\">\n                    <div class=\"col-lg-6\">\n                        <p class=\"section-label\">Green IT SaaS solution</p>\n                        <h1 id=\"hero-title\">Greenspector Studio</h1>\n                        <p class=\"hero-subtitle\">The SaaS solution to validate the frugality and performance of your\n                            apps. Cover the blind spots of software quality.</p>\n                        <div class=\"hero-actions\">\n                            <a class=\"btn btn-gs-primary\" href=\"./contact/\">Request a demo</a>\n                            <a class=\"btn btn-gs-outline\" href=\"./studio/banc-tests-mobiles/\">Discover Greenspector\n                                Studio</a>\n                        </div>\n                    </div>\n                    <div class=\"col-lg-6\">\n                        <figure class=\"hero-figure\">\n                            <img src=\"https://greenspector.com/wp-content/uploads/2024/06/Entete_Accueil.svg\" alt=\"Greenspector Studio interface on smartphone and dashboard\" width=\"680\" height=\"520\" fetchpriority=\"high\">\n                        </figure>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <section class=\"home-section home-section--light\" id=\"problemes\" aria-labelledby=\"problems-title\">\n            <div class=\"container\">\n                <header class=\"home-section-header\">\n                    <h2 id=\"problems-title\">Find your app issues before your users do</h2>\n                </header>\n                <div class=\"home-pillar-grid\">\n                    <article class=\"home-pillar-card home-problem-card\">\n                        <span class=\"studio-step-index\" aria-hidden=\"true\">1</span>\n                        <h3>Battery consumption</h3>\n                    </article>\n                    <article class=\"home-pillar-card home-problem-card\">\n                        <span class=\"studio-step-index\" aria-hidden=\"true\">2</span>\n                        <h3>Performance drop on older devices</h3>\n                    </article>\n                    <article class=\"home-pillar-card home-problem-card\">\n                        <span class=\"studio-step-index\" aria-hidden=\"true\">3</span>\n                        <h3>Journey interruptions when the network degrades</h3>\n                    </article>\n                    <article class=\"home-pillar-card home-problem-card\">\n                        <span class=\"studio-step-index\" aria-hidden=\"true\">4</span>\n                        <h3>Slowdowns caused by AI</h3>\n                    </article>\n                    <article class=\"home-pillar-card home-problem-card\">\n                        <span class=\"studio-step-index\" aria-hidden=\"true\">5</span>\n                        <h3>Environmental impact</h3>\n                    </article>\n                </div>\n            </div>\n        </section>\n\n        <section class=\"home-section\" id=\"comment-ca-marche\" aria-labelledby=\"how-title\">\n            <div class=\"container\">\n                <header class=\"home-section-header\">\n                    <p class=\"eyebrow\">How it works</p>\n                    <h2 id=\"how-title\">Measure, understand and improve in three steps</h2>\n                </header>\n                <div class=\"home-steps-grid\">\n                    <article class=\"studio-card home-step-card\">\n                        <span class=\"studio-step-index\" aria-hidden=\"true\">1</span>\n                        <h3>Describe user journeys</h3>\n                        <p>Describe your user journeys in a few clicks, or use our simple, efficient DSL scripting language to test an Android app, an iOS app or a web journey.\n                        </p>\n                        <figure class=\"home-step-figure\">\n                            <img src=\"https://greenspector.com/wp-content/uploads/2024/09/howItsWork-1.svg\" alt=\"Describing a user journey with the DSL language\" width=\"400\" height=\"300\" loading=\"lazy\" decoding=\"async\">\n                        </figure>\n                    </article>\n                    <article class=\"studio-card home-step-card\">\n                        <span class=\"studio-step-index\" aria-hidden=\"true\">2</span>\n                        <h3>Choose test conditions</h3>\n                        <p>Recent or older device, WiFi or cellular network&nbsp;: choose on our real device cloud\n                            the conditions suited to your goals. Then launch the test or let your CI/CD\n                            run it.</p>\n                        <figure class=\"home-step-figure\">\n                            <img src=\"https://greenspector.com/wp-content/uploads/2024/09/howItsWork-2.svg\" alt=\"Selecting test conditions on the device cloud\" width=\"400\" height=\"300\" loading=\"lazy\" decoding=\"async\">\n                        </figure>\n                    </article>\n                    <article class=\"studio-card home-step-card\">\n                        <span class=\"studio-step-index\" aria-hidden=\"true\">3</span>\n                        <h3>Manage with clear visibility</h3>\n                        <p>Battery consumption, performance, ecoscore, environmental impacts… View your results\n                            in the web interface or use our APIs to export key indicators to your\n                            dashboards. Identify improvement areas and optimise your app&nbsp;!</p>\n                        <figure class=\"home-step-figure\">\n                            <img src=\"https://greenspector.com/wp-content/uploads/2024/09/howItsWork-3.svg\" alt=\"Indicators and impact dashboard\" width=\"400\" height=\"300\" loading=\"lazy\" decoding=\"async\">\n                        </figure>\n                    </article>\n                </div>\n                <aside class=\"home-inline-cta\" aria-label=\"Call to action\">\n                    <p class=\"home-inline-cta__lead\">Move from measurement to action</p>\n                    <div class=\"home-inline-cta__actions\">\n                        <a class=\"btn btn-gs-primary\" href=\"https://saas.greenspector.com/\" target=\"_blank\" rel=\"noopener noreferrer\">Try for free</a>\n                        <a class=\"btn btn-gs-outline btn-gs-outline-dark\" href=\"./contact/\">Request a demo</a>\n                    </div>\n                </aside>\n            </div>\n        </section>\n\n        <section class=\"home-section home-section--light\" id=\"references\" aria-labelledby=\"clients-title\">\n            <div class=\"container\">\n                <header class=\"home-section-header home-section-header--wide\">\n                    <p class=\"eyebrow\">Client references</p>\n                    <h2 id=\"clients-title\">They use Greenspector Studio to combine environmental\n                        responsibility, user satisfaction and application performance</h2>\n                </header>\n                <div class=\"studio-logo-grid home-clients-grid\">\n                    <figure class=\"studio-logo-card\">\n                        <img src=\"./assets/img/external/greenspector.com/client_sncfconnect_04f4832d.jpg\" alt=\"SNCF Connect logo\" width=\"200\" height=\"80\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                    <figure class=\"studio-logo-card\">\n                        <img src=\"./assets/img/external/greenspector.com/client_cats_8cc5042d.jpg\" alt=\"CATS logo\" width=\"200\" height=\"80\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                    <figure class=\"studio-logo-card\">\n                        <img src=\"./assets/img/external/greenspector.com/Logo_AirFrance_616731c4.webp\" alt=\"Air France logo\" width=\"200\" height=\"80\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                    <figure class=\"studio-logo-card\">\n                        <img src=\"./assets/img/external/greenspector.com/logo-bouygues-telecom_889990d1.svg\" alt=\"Bouygues Telecom logo\" width=\"200\" height=\"80\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                    <figure class=\"studio-logo-card\">\n                        <img src=\"./assets/img/external/greenspector.com/client_orange_338b842b.jpg\" alt=\"Orange logo\" width=\"200\" height=\"80\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                    <figure class=\"studio-logo-card\">\n                        <img src=\"./assets/img/external/greenspector.com/Logo-France-televisions-300x157_e988d666.jpg\" alt=\"France Télévisions logo\" width=\"200\" height=\"80\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                    <figure class=\"studio-logo-card\">\n                        <img src=\"./assets/img/external/greenspector.com/client_regionbretagne_b8829f76.jpg\" alt=\"Région Bretagne logo\" width=\"200\" height=\"80\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                </div>\n            </div>\n        </section>\n\n        <section class=\"home-section\" id=\"avantages\" aria-labelledby=\"features-title\">\n            <div class=\"container\">\n                <header class=\"home-section-header\">\n                    <p class=\"eyebrow\">Why Greenspector Studio</p>\n                    <h2 id=\"features-title\">From device to app, manage energy, impacts and performance</h2>\n                </header>\n                <div class=\"home-feature-grid\">\n                    <article class=\"home-feature-card\">\n                        <div class=\"home-feature-card__icon\" aria-hidden=\"true\">\n                            <i class=\"fa-solid fa-mobile-screen\"></i>\n                        </div>\n                        <h3 class=\"home-feature-card__title\">Real, stable Android and iOS devices for reliable,\n                            repeatable measurements</h3>\n                    </article>\n                    <article class=\"home-feature-card\">\n                        <div class=\"home-feature-card__icon\" aria-hidden=\"true\">\n                            <i class=\"fa-solid fa-battery-half\"></i>\n                        </div>\n                        <h3 class=\"home-feature-card__title\">The only device cloud with real, precise\n                            battery consumption measurement</h3>\n                    </article>\n                    <article class=\"home-feature-card\">\n                        <div class=\"home-feature-card__icon\" aria-hidden=\"true\">\n                            <i class=\"fa-solid fa-shield-halved\"></i>\n                        </div>\n                        <h3 class=\"home-feature-card__title\">The only sovereign device cloud</h3>\n                    </article>\n                    <article class=\"home-feature-card\">\n                        <div class=\"home-feature-card__icon\" aria-hidden=\"true\">\n                            <i class=\"fa-solid fa-plug\"></i>\n                        </div>\n                        <h3 class=\"home-feature-card__title\">No changes to your source code, no SDK to\n                            add</h3>\n                    </article>\n                    <article class=\"home-feature-card\">\n                        <div class=\"home-feature-card__icon\" aria-hidden=\"true\">\n                            <i class=\"fa-brands fa-gitlab\"></i>\n                        </div>\n                        <h3 class=\"home-feature-card__title\">Easily integrated into your CI/CD&nbsp;: GitLab CI\n                        </h3>\n                    </article>\n                </div>\n            </div>\n        </section>\n\n        <section class=\"home-section home-section--light\" id=\"cas-client\" aria-labelledby=\"case-title\">\n            <div class=\"container\">\n                <article class=\"home-case-study-panel\">\n                    <div class=\"home-case-study-copy\">\n                        <header class=\"home-case-study-header\">\n                            <p class=\"eyebrow\">Client case study</p>\n                            <h2 id=\"case-title\">Bouygues Telecom obtains the Digital Frugality Certificate</h2>\n                        </header>\n                        <p class=\"home-case-study-lead\">Silver level, with a <strong>36&nbsp;%</strong>\n                            reduction in carbon impact on the Android mobile journey —\n                            <strong>693&nbsp;tCO2e avoided per year</strong>.</p>\n                        <ul class=\"home-case-study-highlights\">\n                            <li>Progression from Bronze to Silver level in two years</li>\n                            <li>Regular measurements via Greenspector Studio integrated into CI/CD</li>\n                            <li>Customer Portal application used by millions of customers every month</li>\n                        </ul>\n                        <blockquote class=\"studio-quote home-case-study-quote\">\n                            <p>With Greenspector Studio, we measure the energy efficiency of our application,\n                                used by 7 million customers every month, after each build. This allows us to\n                                reduce our carbon footprint, improve our performance and strengthen our\n                                brand image.</p>\n                            <footer>\n                                <img src=\"./assets/img/external/greenspector.com/FLankar-150x150_9a821a87.jpg\" alt=\"\" width=\"64\" height=\"64\" loading=\"lazy\" decoding=\"async\">\n                                <div>\n                                    <cite>François Lankar</cite>\n                                    <span>Head of Mobile Care and Assistance Division, Bouygues Telecom</span>\n                                </div>\n                            </footer>\n                        </blockquote>\n                        <a class=\"btn btn-gs-primary\" href=\"./ressources/etudes-de-cas/bouygues-telecom-sobriete-numerique-mobile/\">Read the case\n                            study</a>\n                    </div>\n                    <figure class=\"home-case-study-figure\">\n                        <img src=\"./assets/img/external/greenspector.com/cas-client-BT-X-Greenspector-768x432_f340795e.png\" alt=\"Silver Digital Frugality certification for the Bouygues Telecom application\" width=\"768\" height=\"432\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                </article>\n            </div>\n        </section>\n\n        <section class=\"home-final-cta\" aria-labelledby=\"final-cta-title\">\n            <div class=\"container\">\n                <h2 id=\"final-cta-title\">Ready to improve your app quality like never before&nbsp;?</h2>\n                <a class=\"btn btn-gs-primary btn-lg\" href=\"./contact/\">Request a demo</a>\n            </div>\n        </section>",
  "ldJson": "{\n        \"@context\": \"https://schema.org\",\n        \"@type\": \"SoftwareApplication\",\n        \"name\": \"Greenspector Studio\",\n        \"applicationCategory\": \"BusinessApplication\",\n        \"operatingSystem\": \"Web\",\n        \"description\": \"SaaS solution to validate the frugality and performance of mobile and web applications on real devices.\",\n        \"provider\": {\n            \"@type\": \"Organization\",\n            \"name\": \"Greenspector\",\n            \"url\": \"https://greenspector.com/\"\n        }\n    }"
