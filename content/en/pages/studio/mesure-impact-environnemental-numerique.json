  "bodyHtml": "<div class=\"content-panel studio-page\">\n                    <section class=\"studio-intro studio-section\">\n                        <div class=\"studio-copy\">\n                            <p class=\"eyebrow\">Methodology</p>\n                            <h2>Assess the environmental impact of your digital services, seriously</h2>\n                            <p>Our exclusive methodology is the result of over 12 years of R&amp;D. Rigorous and\n                                precise, it is compatible with recognised industry standards.</p>\n                            <p>Assessment is based on user journey measurements in real conditions\n                                (devices, networks), with direct measurement of energy consumed to ensure high\n                                accuracy.</p>\n                            <p>Quantifying impacts is essential. Understanding their causes is even more so.\n                                Greenspector Studio helps your teams target concretely what needs improving.</p>\n                        </div>\n                        <figure class=\"studio-figure\">\n                            <a href=\"https://greenspector.com/wp-content/uploads/2025/05/Methodology_Greenspector_full_EN-Version-202405.pdf\" target=\"_blank\" rel=\"noopener noreferrer\">\n                                <img src=\"../../assets/img/external/greenspector.com/Methodology-r5y7lv86b58y4wgy8rsho0gxcgzljwo672bgw1503c_fa9736b8.jpg\" alt=\"Greenspector Studio methodology document cover\">\n                            </a>\n                        </figure>\n                    </section>\n\n                    <section class=\"studio-section studio-highlight\">\n                        <div class=\"studio-copy\">\n                            <p class=\"eyebrow\">Direct measurement</p>\n                            <h2>The only solution with direct energy measurement</h2>\n                            <p><strong>Energy consumption on the user device is a determining factor</strong>\n                                of a digital service's environmental impact. Without this measurement, much of\n                                real behaviour is ignored.</p>\n                            <p>With Greenspector Studio, you identify the most significant impact causes\n                                to take truly effective reduction actions.</p>\n                            <p><a href=\"https://greenspector.com/mesure-performance-et-energie-du-numerique/\" target=\"_blank\" rel=\"noopener noreferrer\">How to assess your digital service</a></p>\n                        </div>\n                        <figure class=\"studio-figure\">\n                            <img src=\"../../assets/img/external/greenspector.com/Interface_Energie-r66sueixesun55ua1ve1nr88ou4vnu2g402pfmteig_d0f89802.png\" alt=\"Energy consumption curve by journey step\">\n                        </figure>\n                    </section>\n\n                    <section class=\"studio-section\">\n                        <p class=\"eyebrow\">Multi-criteria</p>\n                        <h2>8 environmental impact indicators for a complete analysis</h2>\n                        <div class=\"studio-grid studio-mini-grid\">\n                            <article class=\"studio-card studio-card-compact\">\n                                <h3>Greenhouse gases</h3>\n                                <p>kg CO2eq</p>\n                            </article>\n                            <article class=\"studio-card studio-card-compact\">\n                                <h3>Atmospheric acidification</h3>\n                                <p>kg mol H+ eq</p>\n                            </article>\n                            <article class=\"studio-card studio-card-compact\">\n                                <h3>Ionising radiation</h3>\n                                <p>kBq U235 eq</p>\n                            </article>\n                            <article class=\"studio-card studio-card-compact\">\n                                <h3>Abiotic resource depletion</h3>\n                                <p>kg Sb eq</p>\n                            </article>\n                            <article class=\"studio-card studio-card-compact\">\n                                <h3>Particulate emissions</h3>\n                                <p>Disease incidence rate</p>\n                            </article>\n                            <article class=\"studio-card studio-card-compact\">\n                                <h3>Photochemical ozone</h3>\n                                <p>kg NMVOC eq</p>\n                            </article>\n                            <article class=\"studio-card studio-card-compact\">\n                                <h3>Fossil resources</h3>\n                                <p>MJ</p>\n                            </article>\n                            <article class=\"studio-card studio-card-compact\">\n                                <h3>Aquatic ecotoxicity</h3>\n                                <p>CTUe</p>\n                            </article>\n                        </div>\n                        <p><em>Criteria marked ADEME are aligned with digital service RCPs, as a\n                                declination of the European PEF methodology.</em></p>\n                        <figure class=\"studio-figure\">\n                            <img src=\"../../assets/img/external/greenspector.com/ImpactsEnvironnementaux-_7447eddf.png\" alt=\"Visualisation of measured environmental impacts\">\n                        </figure>\n                    </section>\n\n                    <section class=\"studio-section\">\n                        <p class=\"eyebrow\">Ecoscore</p>\n                        <h2>The Greenspector ecoscore: simple in appearance, robust in its calculation</h2>\n                        <p>Each journey step is assessed on three axes: display time, energy\n                            consumption and data consumption. For each axis, steps are categorised then\n                            converted to a score from 0 to 100.</p>\n                        <ol>\n                            <li>Each step is ranked by performance category.</li>\n                            <li>The volume of steps per category is used to calculate a score.</li>\n                            <li>Three scores are produced: energy, data, display.</li>\n                            <li>The final ecoscore is the average of the three axes, weighted between critical and non-critical\n                                steps.</li>\n                        </ol>\n                        <p><em>The final ecoscore combines critical (70%) and non-critical (30%) steps to better\n                                reflect real usage.</em></p>\n                        <figure class=\"studio-figure\">\n                            <img src=\"../../assets/img/external/greenspector.com/Greenspector-Studio-Ecoscore-r3tmosfu8yqrw3ak5b8noo6ypd23wbpp1qnna0qh14_fdbe25f9.png\" alt=\"Ecoscore Greenspector Studio\">\n                        </figure>\n                    </section>\n\n                    <section class=\"studio-section studio-quote-section\">\n                        <p class=\"eyebrow\">What they say</p>\n                        <blockquote class=\"studio-quote\">\n                            <p>To ensure maximum ecoscore reliability, teams relied on\n                                Greenspector, which reliably assesses the environmental impact of a\n                                health application.</p>\n                            <p>Greenspector is based on measurement throughout the real usage journey, not\n                                solely on loading a home page.</p>\n                            <footer>\n                                <img src=\"../../assets/img/external/greenspector.com/BSeroussi-150x148_bb960bb4.jpg\" alt=\"Portrait of Dr Brigitte Seroussi\">\n                                <div>\n                                    <strong>Dr Brigitte Seroussi</strong>\n                                    <span>Project Director, French Digital Health Agency</span>\n                                </div>\n                            </footer>\n                        </blockquote>
</section>\n\n                    <section class=\"studio-section studio-highlight\">\n                        <div class=\"studio-copy\">\n                            <p class=\"eyebrow\">Certificate</p>\n                            <h2>Digital Service Efficiency Certificate</h2>\n                            <p>If your journey ecoscore is above 50/100, you can request\n                                approval of your measurement to obtain our certificate, as well as a badge\n                                publishable on your digital channels.</p>\n                            <p><a href=\"https://greenspector.com/fr/depairfran-certification-af_mobile-15-0/\" target=\"_blank\" rel=\"noopener noreferrer\">View a certified badge example</a></p>\n                        </div>\n                        <figure class=\"studio-figure\">\n                            <img src=\"../../assets/img/external/greenspector.com/Black-Bronze-qukng3csmu29aq8dpyzj8yozfg830226plpo54fet4_35d0c8f4.png\" alt=\"Example of digital efficiency certificate\">\n                        </figure>\n                    </section>\n\n                    <section class=\"studio-section\">\n                        <p class=\"eyebrow\">Business integration</p>\n                        <h2>Integrate results into your carbon reports, LCAs and internal tools</h2>\n                        <p>Results from our impact model can be used in your GHG reports or\n                            life cycle analyses. Each value is provided with its uncertainty level for greater\n                            transparency.</p>\n                        <p>Our API also lets you automate recalculations, hypothesis scenarios and\n                            integration with your management tools.</p>\n                        <div class=\"studio-grid\">\n                            <figure class=\"studio-figure\">\n                                <img src=\"../../assets/img/external/greenspector.com/ImpactsProjectionAnnuelle--rnqninyafs7256klgvbxtoabbjk0amy0ozj5uqw1bs_18ea0e85.png\" alt=\"Annual projection of environmental impacts\">\n                            </figure>\n                            <figure class=\"studio-figure\">\n                                <img src=\"../../assets/img/external/greenspector.com/api-impact-r41oyt5evc16pg21de2f6n95xm8ow7kfsjaj0mdxh4_116a85d5.png\" alt=\"Greenspector Studio impact API\">\n                            </figure>\n                        </div>\n                    </section>\n\n                    <section class=\"studio-section\">\n                        <p class=\"eyebrow\">R&amp;D</p>\n                        <h2>Our research, the foundation of our products and expertise</h2>\n                        <p>For over 12 years, we have innovated in measuring and assessing the impact of digital\n                            services. This work has led to numerous scientific publications and\n                            presentations at international conferences.</p>\n                        <ul>\n                            <li><a href=\"https://www.fftelecoms.org/etudes-et-publications/etude-sur-limpact-de-lecoconception-des-services-numeriques/\" target=\"_blank\" rel=\"noopener noreferrer\">FFT 2026 study on the impact of ecodesign</a></li>\n                            <li><a href=\"https://hal.science/hal-04532041/document\" target=\"_blank\" rel=\"noopener noreferrer\">Managing Uncertainties in ICT Services Life Cycle Assessment using Fuzzy Logic</a></li>\n                            <li><a href=\"https://dl.acm.org/doi/pdf/10.1145/3647632.3651391\" target=\"_blank\" rel=\"noopener noreferrer\">Assessing the environmental impact of mobile applications</a></li>\n                            <li><a href=\"https://ebooks.iospress.nl/volumearticle/67452\" target=\"_blank\" rel=\"noopener noreferrer\">Development of an ecoscore for health apps</a></li>\n                        </ul>\n                        <figure class=\"studio-figure\">\n                            <img src=\"../../assets/img/external/greenspector.com/RD_Investigating-1-r65g8xcx7ly68v1xrnfmv8b1v9318crkww8pngs7g8_aa071be4.png\" alt=\"Illustration of Greenspector R&amp;D work\">\n                        </figure>\n                        <p class=\"text-center\"><a class=\"btn btn-gs-primary\" href=\"../../contact/\">Request a free demo</a></p>\n                    </section>\n\n                    <section class=\"studio-section\">\n                        <p class=\"eyebrow\">Standards</p>\n                        <h2>Compatible with leading industry standards</h2>\n                        <div class=\"studio-grid studio-mini-grid\">\n                            <article class=\"studio-card studio-card-compact\">\n                                <h3>Recognised references</h3>\n                                <p>Solution recognised for its environmental efficiency and measurement rigour.</p>\n                            </article>\n                            <article class=\"studio-card studio-card-compact\">\n                                <h3>Scientific approach</h3>\n                                <p>A methodology powered by R&amp;D and international publications.</p>\n                            </article>\n                            <article class=\"studio-card studio-card-compact\">\n                                <h3>Standards compatibility</h3>\n                                <p>LCA (ISO 14040), Green Software Foundation SCI, ADEME RCP and related frameworks.</p>\n                            </article>\n                        </div>\n                    </section>\n\n                    <section class=\"studio-section\">\n                        <p class=\"eyebrow\">References</p>\n                        <h2>They use Greenspector Studio</h2>\n                        <p>To combine environmental responsibility, user satisfaction and application\n                            performance.</p>\n                        <div class=\"studio-logo-grid\">\n                            <figure class=\"studio-logo-card\">\n                        <img src=\"../../assets/img/external/greenspector.com/client_sncfconnect_04f4832d.jpg\" alt=\"SNCF Connect logo\" width=\"200\" height=\"80\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                    <figure class=\"studio-logo-card\">\n                        <img src=\"../../assets/img/external/greenspector.com/client_cats_8cc5042d.jpg\" alt=\"CATS logo\" width=\"200\" height=\"80\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                    <figure class=\"studio-logo-card\">\n                        <img src=\"../../assets/img/external/greenspector.com/Logo_AirFrance_616731c4.webp\" alt=\"Air France logo\" width=\"200\" height=\"80\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                    <figure class=\"studio-logo-card\">\n                        <img src=\"../../assets/img/external/greenspector.com/logo-bouygues-telecom_889990d1.svg\" alt=\"Bouygues Telecom logo\" width=\"200\" height=\"80\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                    <figure class=\"studio-logo-card\">\n                        <img src=\"../../assets/img/external/greenspector.com/client_orange_338b842b.jpg\" alt=\"Orange logo\" width=\"200\" height=\"80\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                    <figure class=\"studio-logo-card\">\n                        <img src=\"../../assets/img/external/greenspector.com/Logo-France-televisions-300x157_e988d666.jpg\" alt=\"France Télévisions logo\" width=\"200\" height=\"80\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                    <figure class=\"studio-logo-card\">\n                        <img src=\"../../assets/img/external/greenspector.com/logo_Decathlon_150_b97b60d5.png\" alt=\"Decathlon logo\" width=\"200\" height=\"80\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                    <figure class=\"studio-logo-card\">\n                        <img src=\"../../assets/img/external/swiftask-prod-files.s3.eu-west-3.amazonaws.com/slide1_shape10_442219a7.png\" alt=\"French Ministry of Health logo\" width=\"200\" height=\"80\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                        </div>\n                    </section>\n\n                    <section class=\"studio-section\" style=\"text-align: center;\">\n                        <h2>Our certifications</h2>\n                        <figure class=\"studio-figure\">\n                            <img src=\"/assets/images/ecovadis-gold-medal.png\" alt=\"EcoVadis Gold Medal\" width=\"250\" height=\"250\" loading=\"lazy\" decoding=\"async\" style=\"max-width: 250px; width: 100%; height: auto;\">\n                        </figure>\n                        <a class=\"btn btn-gs-primary\" href=\"/assets/documents/ecovadis-scorecard.pdf\" target=\"_blank\" rel=\"noopener noreferrer\">Discover our evaluation</a>\n                    </section>\n                </div>"
}
