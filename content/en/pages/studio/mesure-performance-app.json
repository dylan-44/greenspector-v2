  "bodyHtml": "<section class=\"studio-intro studio-section\">\n                        <div class=\"studio-copy\">\n                            <p class=\"eyebrow\">Real performance</p>\n                            <h2>Measure application performance on real devices</h2>\n                            <p>Greenspector Studio assesses the performance of your <strong>user journeys</strong>\n                                on physical smartphones and tablets from different generations.</p>\n                            <p>Choose the device and network according to your goals. Analyse results at\n                                journey and step level to easily identify pain points that\n                                affect your users.</p>\n                        </div>\n                        <figure class=\"studio-figure\">\n                            <img src=\"../../assets/img/external/greenspector.com/TestBench_FR-r5ydm7qvcdeudu7oxaf6kf2bj6mz7xk1xvwrescvy0_c76a775e.png\" alt=\"Device selection in the Greenspector Device Lab\">\n                        </figure>\n                    </section>\n\n                    <section class=\"studio-section studio-highlight\">\n                        <div class=\"studio-copy\">\n                            <p class=\"eyebrow\">Measurement precision</p>\n                            <h2>Ultra-precise battery consumption measurement</h2>\n                            <p>Our solution directly measures <strong>battery consumption</strong> throughout the\n                                user journey with fine granularity: <strong>µAh/s every\n                                    200 ms</strong>.</p>\n                            <p>Direct, ultra-precise measurement provides a new perspective on the real behaviour of\n                                your mobile application, where classic profiling tools remain approximate.\n                            </p>\n                        </div>\n                        <figure class=\"studio-figure\">\n                            <img src=\"../../assets/img/external/greenspector.com/Interface_Energie-r66sueixesun55ua1ve1nr88ou4vnu2g402pfmteig_d0f89802.png\" alt=\"Energy consumption curve by journey step\">\n                        </figure>\n                    </section>\n\n                    <section class=\"studio-section\">\n                        <p class=\"eyebrow\">Diagnostics</p>\n                        <h2>Identify and locate overconsumption</h2>\n                        <p>Greenspector Studio quickly identifies <strong>performance\n                                bugs</strong>, <strong>energy bugs</strong> and <strong>resource\n                                bugs</strong> in your applications.</p>\n                        <div class=\"studio-grid\">\n                            <article class=\"studio-card studio-card-compact\">\n                                <h3>System metrics</h3>\n                                <p>Energy consumption, inbound/outbound data, CPU, memory and Android\n                                    metrics for fine-grained software behaviour analysis.</p>\n                            </article>\n                            <article class=\"studio-card studio-card-compact\">\n                                <h3>Targeted reports</h3>\n                                <p>Locate <strong>technical and design issues</strong> and prioritise\n                                    fixes with detailed step-by-step reports.</p>\n                            </article>\n                        </div>\n                        <figure class=\"studio-figure\">\n                            <img src=\"../../assets/img/external/greenspector.com/Interface_Energie-par-etape-r63byp63s0kjum3ot2ueiqc9paw1fjflobxqd6n4jc_7e2fbfe9.png\" alt=\"Energy consumption analysis by journey step\">\n                        </figure>\n                    </section>\n\n                    <section class=\"studio-section studio-highlight\">\n                        <div class=\"studio-copy\">\n                            <p class=\"eyebrow\">Measurement strategy</p>\n                            <h2>Manage performance by results</h2>\n                            <p>Define your measurement strategy by identifying the main usage types of\n                                the application:</p>\n                            <ul>\n                                <li>User with latest-generation phone and <strong>4G</strong></li>\n                                <li>Mobile user with <strong>mid-range phone</strong></li>\n                                <li>User in low-coverage area with <strong>refurbished phone</strong></li>\n                            </ul>\n                            <p>Then define what is measured: pages or <strong>representative\n                                    journeys</strong> covering main features, based on\n                                real usage statistics.</p>\n                        </div>\n                        <figure class=\"studio-figure\">\n                            <img src=\"../../assets/img/external/greenspector.com/ScriptGDSL-rnqpg1fgul47nbs0d4uarck0is9nkrfa3werw2g51y_63db4caf.png\" alt=\"GDSL script to automate test journeys\">\n                        </figure>\n                    </section>\n\n                    <section class=\"studio-section\">\n                        <p class=\"eyebrow\">Continuous tracking</p>\n                        <h2>Integrate performance into your release cycle</h2>\n                        <p>Run a measurement before each release to detect anomalies as early as possible and track\n                            trends over time. Greenspector APIs let you trigger tests from your\n                            CI/CD pipelines and export results to your dashboards.</p>\n                        <p><a href=\"../devgreenops/\">Learn more about continuous integration</a></p>\n                        <figure class=\"studio-figure\">\n                            <img src=\"../../assets/img/external/greenspector.com/evolution-r41o1fvo92cqjsiy7yt7o2e2r6pln13h7djzozv2d4_4627dddb.png\" alt=\"Performance indicator trends across versions\">\n                        </figure>\n                    </section>\n\n                    <section class=\"studio-section studio-highlight\">\n                        <div class=\"studio-copy\">\n                            <p class=\"eyebrow\">Get started now</p>\n                            <h2>The leading SaaS solution for app performance measurement</h2>\n                            <p>Measure, analyse and optimise the performance of your mobile applications and websites\n                                with Greenspector Studio. Our SaaS solution integrates easily into your\n                                development environment for continuous application performance management.\n                            </p>\n                            <p class=\"text-center\"><a class=\"btn btn-gs-primary\" href=\"../../contact/\">Request a\n                                        free demo</a></p>
</div>\n                    </section>\n\n                    <section class=\"studio-section\">\n                        <p class=\"eyebrow\">Standards</p>\n                        <h2>Compatible with leading industry frameworks</h2>\n                        <div class=\"studio-grid studio-mini-grid\">\n                            <article class=\"studio-card studio-card-compact\">\n                                <h3>Recognition</h3>\n                                <p>Solution recognised for its environmental efficiency and measurement precision.</p>\n                            </article>\n                            <article class=\"studio-card studio-card-compact\">\n                                <h3>R&amp;D</h3>\n                                <p>Continuous innovation driven by research and field feedback for over\n                                    12 years.</p>\n                            </article>\n                            <article class=\"studio-card studio-card-compact\">\n                                <h3>Standards compatibility</h3>\n                                <p>LCA (ISO 14040), Green Software Foundation SCI, ADEME RCP and related references.\n                                </p>\n                            </article>\n                        </div>\n                    </section>\n\n                    <section class=\"studio-section\">\n                        <p class=\"eyebrow\">References</p>\n                        <h2>They use Greenspector Studio</h2>\n                        <p>To combine environmental responsibility, user satisfaction and application\n                            performance.</p>\n                        <div class=\"studio-logo-grid\">\n                            <figure class=\"studio-logo-card\">\n                        <img src=\"/assets/img/external/greenspector.com/client_sncfconnect_04f4832d.jpg\" alt=\"SNCF Connect logo\" width=\"200\" height=\"80\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                    <figure class=\"studio-logo-card\">\n                        <img src=\"/assets/img/external/greenspector.com/client_cats_8cc5042d.jpg\" alt=\"CATS logo\" width=\"200\" height=\"80\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                    <figure class=\"studio-logo-card\">\n                        <img src=\"/assets/img/external/greenspector.com/Logo_AirFrance_616731c4.webp\" alt=\"Air France logo\" width=\"200\" height=\"80\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                    <figure class=\"studio-logo-card\">\n                        <img src=\"/assets/img/external/greenspector.com/logo-bouygues-telecom_889990d1.svg\" alt=\"Bouygues Telecom logo\" width=\"200\" height=\"80\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                    <figure class=\"studio-logo-card\">\n                        <img src=\"/assets/img/external/greenspector.com/client_orange_338b842b.jpg\" alt=\"Orange logo\" width=\"200\" height=\"80\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                    <figure class=\"studio-logo-card\">\n                        <img src=\"/assets/img/external/greenspector.com/Logo-France-televisions-300x157_e988d666.jpg\" alt=\"France Télévisions logo\" width=\"200\" height=\"80\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                    <figure class=\"studio-logo-card\">\n                        <img src=\"/assets/img/external/greenspector.com/logo_Decathlon_150_b97b60d5.png\" alt=\"Decathlon logo\" width=\"200\" height=\"80\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                    <figure class=\"studio-logo-card\">\n                        <img src=\"/assets/img/external/swiftask-prod-files.s3.eu-west-3.amazonaws.com/slide1_shape10_442219a7.png\" alt=\"French Ministry of Health logo\" width=\"200\" height=\"80\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                        </div>\n                    </section>\n
                    <section class=\"studio-section\" style=\"text-align: center;\">\n                        <h2>[TITRE_SECTION_CERTIFICATIONS]</h2>\n                        <figure class=\"studio-figure\">\n                            <img src=\"/assets/images/ecovadis-gold-medal.png\" alt=\"EcoVadis Gold Medal\" width=\"250\" height=\"250\" loading=\"lazy\" decoding=\"async\" style=\"max-width: 250px; width: 100%; height: auto;\">\n                        </figure>\n                        <a class=\"btn btn-gs-primary\" href=\"/assets/documents/ecovadis-scorecard.pdf\" target=\"_blank\" rel=\"noopener noreferrer\">[CTA_DECOUVRIR_EVALUATION]</a>\n                    </section>"
