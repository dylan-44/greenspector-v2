  "bodyHtml": "<section class=\"hero hero-home hero-home-banner\" aria-labelledby=\"hero-title\">\n            <div class=\"hero-home-banner__media\" aria-hidden=\"true\">\n                <img src=\"/assets/img/banc_de_test_illustration.png\" alt=\"\" width=\"1456\" height=\"816\" fetchpriority=\"high\" decoding=\"async\">\n                <div class=\"hero-home-banner__overlay\"></div>\n            </div>\n            <div class=\"container hero-home-banner__content\">\n                <div class=\"hero-home-banner__copy\"><h1 id=\"hero-title\"><span class=\"hero-home-banner__title-line\">Greenspector</span><span class=\"hero-home-banner__title-line\">Studio</span></h1>\n                    <p class=\"hero-subtitle\">La solution SaaS pour valider la sobriété et la performance de vos apps.<br>\n                        Couvrez les angles morts de la qualité logicielle&nbsp;!</p>\n                    <div class=\"hero-actions\">\n                        <a class=\"btn btn-gs-primary\" href=\"./contact/\">Demander une démo</a>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <section class=\"home-section home-section--light\" id=\"problemes\" aria-labelledby=\"problems-title\">\n            <div class=\"container\">\n                <header class=\"home-section-header\">\n                    <h2 id=\"problems-title\">Découvrez les problèmes de votre app avant vos utilisateurs</h2>\n                </header>\n                <div class=\"home-pillar-grid\">\n                    <article class=\"home-pillar-card home-problem-card\">\n                        <div class=\"home-problem-card__icon\" aria-hidden=\"true\">\n                            <i class=\"fa-solid fa-battery-full\"></i>\n                        </div>\n                        <h3>Consommation de batterie</h3>\n                    </article>\n                    <article class=\"home-pillar-card home-problem-card\">\n                        <div class=\"home-problem-card__icon\" aria-hidden=\"true\">\n                            <i class=\"fa-solid fa-gauge-high\"></i>\n                        </div>\n                        <h3>Baisse de performance sur terminaux anciens</h3>\n                    </article>\n                    <article class=\"home-pillar-card home-problem-card\">\n                        <div class=\"home-problem-card__icon\" aria-hidden=\"true\">\n                            <i class=\"fa-solid fa-wifi\"></i>\n                        </div>\n                        <h3>Interruptions de parcours quand le réseau se dégrade</h3>\n                    </article>\n                    <article class=\"home-pillar-card home-problem-card\">\n                        <div class=\"home-problem-card__icon\" aria-hidden=\"true\">\n                            <i class=\"fa-solid fa-microchip\"></i>\n                        </div>\n                        <h3>Ralentissements à cause de l'IA</h3>\n                    </article>\n                    <article class=\"home-pillar-card home-problem-card\">\n                        <div class=\"home-problem-card__icon\" aria-hidden=\"true\">\n                            <i class=\"fa-solid fa-leaf\"></i>\n                        </div>\n                        <h3>Impact environnemental</h3>\n                    </article>\n                </div>\n            </div>\n        </section>\n\n        <section class=\"home-section\" id=\"comment-ca-marche\" aria-labelledby=\"how-title\">\n            <div class=\"container\">\n                <header class=\"home-section-header\">\n                    <p class=\"eyebrow\">Comment ça marche</p>\n                    <h2 id=\"how-title\">Mesurez, comprenez, améliorez</h2>\n                </header>\n                <div class=\"home-steps-grid\">\n                    <article class=\"studio-card home-step-card\">\n                        <span class=\"studio-step-index\" aria-hidden=\"true\">1</span>\n                        <h3>Décrivez le parcours utilisateurs</h3>\n                        <p>Décrivez le parcours de vos utilisateurs en quelques clics, ou utilisez notre langage de\n                            script DSL simple et efficace pour tester une app Android, une app iOS ou un parcours web.\n                        </p>\n                        <figure class=\"home-step-figure\">\n                            <img src=\"/assets/img/howitwork/comment-etape-1.png\" alt=\"Description d'un parcours utilisateur avec le langage DSL\" width=\"400\" height=\"300\" loading=\"lazy\" decoding=\"async\">\n                        </figure>\n                    </article>\n                    <article class=\"studio-card home-step-card\">\n                        <span class=\"studio-step-index\" aria-hidden=\"true\">2</span>\n                        <h3>Choisissez les conditions de test</h3>\n                        <p>Terminal récent ou ancien, réseau WiFi ou GSM&nbsp;: choisissez sur notre device cloud réel\n                            les conditions adaptées à vos objectifs. Puis lancez le test ou laissez votre CI/CD le\n                            faire.</p>\n                        <figure class=\"home-step-figure\">\n                            <img src=\"/assets/img/howitwork/comment-etape-2.png\" alt=\"Sélection des conditions de test sur le device cloud\" width=\"400\" height=\"300\" loading=\"lazy\" decoding=\"async\">\n                        </figure>\n                    </article>\n                    <article class=\"studio-card home-step-card\">\n                        <span class=\"studio-step-index\" aria-hidden=\"true\">3</span>\n                        <h3>Pilotez avec une vision claire</h3>\n                        <p>Conso de batterie, performance, écoscore, impacts… Intégrez les KPI dans vos tableaux de bord avec nos API. Identifiez les axes de progrès et optimisez votre app&nbsp;!</p>\n                        <figure class=\"home-step-figure\">\n                            <img src=\"/assets/img/howitwork/comment-etape-3.png\" alt=\"Tableau de bord des indicateurs et impacts\" width=\"400\" height=\"300\" loading=\"lazy\" decoding=\"async\">\n                        </figure>\n                    </article>\n                </div>\n                <aside class=\"home-inline-cta\" aria-label=\"Appel à l'action\">\n                    <p class=\"home-inline-cta__lead\">Passez de la mesure à l'action</p>\n                    <div class=\"home-inline-cta__actions\">\n                        <a class=\"btn btn-gs-outline btn-gs-outline-dark\" href=\"./contact/\">Demander une démo</a>\n                    </div>\n                </aside>\n            </div>\n        </section>\n\n        <section class=\"home-section home-section--light\" id=\"references\" aria-labelledby=\"clients-title\">\n            <div class=\"container\">\n                <header class=\"home-section-header home-section-header--wide\">\n                    <p class=\"eyebrow\">Références clients</p>\n                    <h2 id=\"clients-title\">Ils utilisent Greenspector Studio pour allier satisfaction des utilisateurs, performance de leurs applications et responsabilité environnementale</h2>\n                </header>\n                <div class=\"studio-logo-grid home-clients-grid\">\n                    <figure class=\"studio-logo-card\">\n                        <img src=\"./assets/img/external/greenspector.com/client_sncfconnect_04f4832d.jpg\" alt=\"Logo SNCF Connect\" width=\"200\" height=\"80\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                    <figure class=\"studio-logo-card\">\n                        <img src=\"./assets/img/external/greenspector.com/client_cats_8cc5042d.jpg\" alt=\"Logo CATS\" width=\"200\" height=\"80\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                    <figure class=\"studio-logo-card\">\n                        <img src=\"./assets/img/external/greenspector.com/Logo_AirFrance_616731c4.webp\" alt=\"Logo Air France\" width=\"200\" height=\"80\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                    <figure class=\"studio-logo-card\">\n                        <img src=\"./assets/img/external/greenspector.com/logo-bouygues-telecom_889990d1.svg\" alt=\"Logo Bouygues Telecom\" width=\"200\" height=\"80\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                    <figure class=\"studio-logo-card\">\n                        <img src=\"./assets/img/external/greenspector.com/client_orange_338b842b.jpg\" alt=\"Logo Orange\" width=\"200\" height=\"80\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                    <figure class=\"studio-logo-card\">\n                        <img src=\"./assets/img/external/greenspector.com/Logo-France-televisions-300x157_e988d666.jpg\" alt=\"Logo France Télévisions\" width=\"200\" height=\"80\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                    <figure class=\"studio-logo-card\">\n                        <img src=\"./assets/img/external/greenspector.com/logo_Decathlon_150_b97b60d5.png\" alt=\"Logo Decathlon\" width=\"200\" height=\"80\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                    <figure class=\"studio-logo-card\">\n                        <img src=\"./assets/img/external/swiftask-prod-files.s3.eu-west-3.amazonaws.com/slide1_shape10_442219a7.png\" alt=\"Logo Ministère de la Santé\" width=\"200\" height=\"80\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                </div>\n            </div>\n        </section>\n\n        <section class=\"home-section\" id=\"avantages\" aria-labelledby=\"features-title\">\n            <div class=\"container\">\n                <header class=\"home-section-header\">\n                    <p class=\"eyebrow\">Pourquoi Greenspector Studio</p>\n                    <h2 id=\"features-title\">Du device à l'app, pilotez énergie, impacts et performance</h2>\n                </header>\n                <div class=\"home-feature-grid\">\n                    <article class=\"home-feature-card\">\n                        <div class=\"home-feature-card__icon\" aria-hidden=\"true\">\n                            <i class=\"fa-solid fa-mobile-screen\"></i>\n                        </div>\n                        <h3 class=\"home-feature-card__title\">Terminaux Android et iOS réels et stables pour des mesures\n                            fiables et répétables</h3>\n                    </article>\n                    <article class=\"home-feature-card\">\n                        <div class=\"home-feature-card__icon\" aria-hidden=\"true\">\n                            <i class=\"fa-solid fa-cloud\"></i>\n                        </div>\n                        <h3 class=\"home-feature-card__title\">Le seul device cloud avec mesure réelle et précise de\n                            consommation de batterie</h3>\n                    </article>\n                    <article class=\"home-feature-card\">\n                        <div class=\"home-feature-card__icon\" aria-hidden=\"true\">\n                            <i class=\"fa-solid fa-shield-halved\"></i>\n                        </div>\n                        <h3 class=\"home-feature-card__title\">Souveraineté FR/EU&nbsp;: le seul device cloud français</h3>\n                    </article>\n                    <article class=\"home-feature-card\">\n                        <div class=\"home-feature-card__icon\" aria-hidden=\"true\">\n                            <i class=\"fa-solid fa-code\"></i>\n                        </div>\n                        <h3 class=\"home-feature-card__title\">Pas de changement dans votre code source, pas de SDK à\n                            ajouter</h3>\n                    </article>\n                    <article class=\"home-feature-card\">\n                        <div class=\"home-feature-card__icon\" aria-hidden=\"true\">\n                            <i class=\"fa-solid fa-gears\"></i>\n                        </div>\n                        <h3 class=\"home-feature-card__title\">Facilement intégrable dans votre CI/CD&nbsp;: passez au DevGreenOps</h3>\n                    </article>\n                </div>\n            </div>\n        </section>\n\n        <section class=\"home-section home-section--light\" id=\"cas-client\" aria-labelledby=\"case-title\">\n            <div class=\"container\">\n                <article class=\"home-case-study-panel\">\n                    <div class=\"home-case-study-copy\">\n                        <header class=\"home-case-study-header\">\n                            <p class=\"eyebrow\">Cas client</p>\n                            <h2 id=\"case-title\">Bouygues Telecom obtient le Certificat de Sobriété Numérique</h2>\n                        </header>\n                        <p class=\"home-case-study-lead\">Niveau Argent, avec une réduction de <strong>36&nbsp;%</strong>\n                            de l'impact carbone sur le parcours mobile Android — soit\n                            <strong>693&nbsp;tCO2e évitées par an</strong>.</p>\n                        <ul class=\"home-case-study-highlights\">\n                            <li>Progression du niveau Bronze au niveau Argent en deux ans</li>\n                            <li>Mesures régulières via Greenspector Studio intégrées à la CI/CD</li>\n                            <li>Application Espace Client utilisée par des millions de clients chaque mois</li>\n                        </ul>\n                        <blockquote class=\"studio-quote home-case-study-quote\">\n                            <p>Avec Greenspector Studio, nous mesurons l'efficacité énergétique de notre application,\n                                utilisée par 7 millions de clients chaque mois, après chaque build. Cela nous permet de\n                                réduire notre empreinte carbone, d'améliorer nos performances et de renforcer notre\n                                image de marque.</p>\n                            <footer>\n                                <img src=\"./assets/img/external/greenspector.com/FLankar-150x150_9a821a87.jpg\" alt=\"\" width=\"64\" height=\"64\" loading=\"lazy\" decoding=\"async\">\n                                <div>\n                                    <cite>François Lankar</cite>\n                                    <span>Responsable de Pôle Mobile Care et Assistance, Bouygues Telecom</span>\n                                </div>\n                            </footer>\n                        </blockquote>\n                        <a class=\"btn btn-gs-primary\" href=\"./ressources/etudes-de-cas/bouygues-telecom-sobriete-numerique-mobile/\">Lire l'étude\n                            de cas</a>\n                    </div>\n                    <figure class=\"home-case-study-figure\">\n                        <img src=\"./assets/img/external/greenspector.com/cas-client-BT-X-Greenspector-768x432_f340795e.png\" alt=\"Certification Sobriété Numérique niveau Argent pour l'application Bouygues Telecom\" width=\"768\" height=\"432\" loading=\"lazy\" decoding=\"async\">\n                    </figure>\n                </article>\n            </div>\n        </section>\n\n        <section class=\"home-final-cta\" aria-labelledby=\"final-cta-title\">\n            <div class=\"container\">\n                <h2 id=\"final-cta-title\">Prêt à améliorer la qualité de votre app comme jamais auparavant&nbsp;?</h2>\n                <a class=\"btn btn-gs-primary btn-lg\" href=\"./contact/\">Demander une démo</a>\n            </div>\n        </section>",
  "ldJson": "{\n        \"@context\": \"https://schema.org\",\n        \"@type\": \"SoftwareApplication\",\n        \"name\": \"Greenspector Studio\",\n        \"applicationCategory\": \"BusinessApplication\",\n        \"operatingSystem\": \"Web\",\n        \"description\": \"Solution SaaS pour valider la sobriété et la performance des applications mobile et web sur terminaux réels.\",\n        \"provider\": {\n            \"@type\": \"Organization\",\n            \"name\": \"Greenspector\",\n            \"url\": \"https://greenspector.com/\"\n        }\n    }"
