-plan__stat\">\n                                        <dt>Parcours inclus</dt>\n                                        <dd>1</dd>\n                                    </div>\n                                </dl>\n                                <ul class=\"pricing-plan__highlights\"><li>50 Benchmarks actifs</li>\n                                        <li>1 Parcours Utilisateur</li>\n                                        <li>Scénarios visuels & GDSL</li>\n                                        <li>Service Desk web</li></ul>\n                                <footer class=\"pricing-plan__footer\">\n                                    <a class=\"btn btn-gs-primary pricing-plan__cta\" href=\"/contact/\">Essayer gratuitement</a>\n                                    <a class=\"pricing-plan__compare\" href=\"#pricing-table-title\">Voir le comparatif détaillé</a>\n                                </footer>\n                            </article>\n                            <article class=\"pricing-plan\">\n                                <div class=\"pricing-plan__head\">\n                                    <img class=\"pricing-plan__badge\" src=\"/assets/img/external/greenspector.com/offre_2_star_ff79236f.svg\" alt=\"Offre Team\" width=\"40\" height=\"40\" loading=\"lazy\" decoding=\"async\">\n                                    <h3 class=\"pricing-plan__name\">Team</h3>\n                                </div>\n                                <div class=\"pricing-plan__price-block\">\n                                    <span class=\"pricing-plan__amount\">990 €</span>\n                                    <span class=\"pricing-plan__period\">HT / mois</span>\n                                </div>\n                                <p class=\"pricing-plan__commitment\">Engagement 12 mois</p>\n                                <p class=\"pricing-plan__tagline\">Passez au DevGreenOps avec la mesure de sobriété en CI/CD.</p>\n                                <dl class=\"p